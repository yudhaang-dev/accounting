# Template of the production environment (D3f). Copy it to `.env` on the server and fill in the blanks;
# the real file is never committed. Every value left empty here is a secret or a per-site value.

APP_NAME="Accounting"
APP_ENV=production
# Created on the server with `php artisan key:generate`; never copied from another environment.
APP_KEY=
APP_DEBUG=false
APP_URL=https://

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=accounting
DB_USERNAME=
DB_PASSWORD=

# Browser sessions (ADR-0011): HTTPS only, encrypted payload, idle limit in minutes (IA-FR-05 tightens it per company).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
# Leave empty to bind the cookie to the exact host; set to the parent domain only if the SPA and API differ.
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Not `log`: invitation and reset emails carry tokens that must not be written to log files.
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# The only address `php artisan access:invite-owner` may invite as the first owner, and only while no user exists (ADR-0021).
FIRST_OWNER_EMAIL=

# The SPA is served by this app, so the same origin needs no CORS. List origins only for a separate SPA host (API-TR-02).
CORS_ALLOWED_ORIGINS=

# Integration client tokens, seconds (API-TR-23)
API_TOKEN_TTL_SECONDS=600

WEBHOOK_QUEUE=default
WEBHOOK_TRIES=5
WEBHOOK_TIMEOUT_SECONDS=10
