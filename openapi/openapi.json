{
    "openapi": "3.1.0",
    "info": {
        "title": "Accounting API",
        "version": "1.0.0",
        "description": "Accounting API for the first-party SPA and third-party systems. Contract: .docs/API-CONTRACT.md."
    },
    "servers": [
        {
            "url": "/api/v1"
        }
    ],
    "security": [
        {
            "sessionCookie": []
        },
        {
            "bearerAuth": []
        }
    ],
    "paths": {
        "/csrf-cookie": {
            "get": {
                "operationId": "csrf-cookie",
                "responses": {
                    "204": {
                        "description": "No content"
                    }
                }
            }
        },
        "/me": {
            "get": {
                "operationId": "me",
                "summary": "The signed-in user. Answers 401 `UNAUTHENTICATED` when there is no session, which is how the\nSPA learns that it must show the login screen",
                "tags": [
                    "Me"
                ],
                "responses": {
                    "200": {
                        "description": "`MeResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/MeResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/me/workspaces": {
            "get": {
                "operationId": "me.workspaces",
                "summary": "Workspaces the signed-in user can access right now: active, unexpired memberships only",
                "tags": [
                    "Me"
                ],
                "responses": {
                    "200": {
                        "description": "Array of `WorkspaceResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/WorkspaceResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/workspaces": {
            "post": {
                "operationId": "workspaces.store",
                "summary": "Creates a workspace together with its company (status `setup`); the caller becomes its first member",
                "tags": [
                    "Workspace"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateWorkspaceRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`CreatedWorkspaceResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/CreatedWorkspaceResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sessionCookie": {
                "type": "apiKey",
                "description": "First-party SPA: session cookie from the login flow, plus the XSRF-TOKEN cookie echoed in the X-XSRF-TOKEN header on writes.",
                "in": "cookie",
                "name": "accounting_session"
            },
            "bearerAuth": {
                "type": "http",
                "description": "Integration clients: OAuth 2.0 client-credentials access token. Treat it as opaque. Writes require an Idempotency-Key header.",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "CreateWorkspaceRequest": {
                "type": "object",
                "properties": {
                    "workspace_name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "company_name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "functional_currency": {
                        "type": "string",
                        "description": "Checked against the currency reference data once it exists (M2-03).",
                        "pattern": "^[A-Z]{3}$"
                    },
                    "timezone": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "default_locale": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "id",
                            "en",
                            null
                        ]
                    }
                },
                "required": [
                    "workspace_name",
                    "company_name",
                    "functional_currency"
                ],
                "title": "CreateWorkspaceRequest"
            },
            "CreatedWorkspaceResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "company_id": {
                        "type": "string"
                    },
                    "company_name": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "company_id",
                    "company_name"
                ],
                "title": "CreatedWorkspaceResource"
            },
            "MeResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "email_verified": {
                        "type": "boolean"
                    },
                    "two_factor_enabled": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "email_verified",
                    "two_factor_enabled"
                ],
                "title": "MeResource"
            },
            "WorkspaceResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "company_id": {
                        "type": "string"
                    },
                    "company_name": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "company_id",
                    "company_name"
                ],
                "title": "WorkspaceResource"
            }
        },
        "responses": {
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            }
        }
    }
}