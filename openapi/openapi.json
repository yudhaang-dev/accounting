{
    "openapi": "3.1.0",
    "info": {
        "title": "Accounting API",
        "version": "0.1.0",
        "description": "Accounting API for the first-party SPA and third-party systems. Contract: .docs/API-CONTRACT.md."
    },
    "servers": [
        {
            "url": "/api/v1"
        }
    ],
    "security": [
        {
            "sessionCookie": []
        },
        {
            "bearerAuth": []
        }
    ],
    "paths": {
        "/csrf-cookie": {
            "get": {
                "operationId": "csrf-cookie",
                "responses": {
                    "204": {
                        "description": "No content"
                    }
                }
            }
        },
        "/me": {
            "get": {
                "operationId": "me",
                "summary": "The signed-in user. Answers 401 `UNAUTHENTICATED` when there is no session, which is how the\nSPA learns that it must show the login screen",
                "tags": [
                    "Me"
                ],
                "responses": {
                    "200": {
                        "description": "`MeResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/MeResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sessionCookie": {
                "type": "apiKey",
                "description": "First-party SPA: session cookie from the login flow, plus the XSRF-TOKEN cookie echoed in the X-XSRF-TOKEN header on writes.",
                "in": "cookie",
                "name": "accounting_session"
            },
            "bearerAuth": {
                "type": "http",
                "description": "Integration clients: OAuth 2.0 client-credentials access token. Treat it as opaque. Writes require an Idempotency-Key header.",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "MeResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "email_verified": {
                        "type": "boolean"
                    },
                    "two_factor_enabled": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "email_verified",
                    "two_factor_enabled"
                ],
                "title": "MeResource"
            }
        },
        "responses": {
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}