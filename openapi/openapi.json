{
    "openapi": "3.1.0",
    "info": {
        "title": "Accounting API",
        "version": "1.0.0",
        "description": "Accounting API for the first-party SPA and third-party systems. Contract: .docs/API-CONTRACT.md."
    },
    "servers": [
        {
            "url": "/api/v1"
        }
    ],
    "security": [
        {
            "sessionCookie": []
        },
        {
            "bearerAuth": []
        }
    ],
    "paths": {
        "/csrf-cookie": {
            "get": {
                "operationId": "csrf-cookie",
                "responses": {
                    "204": {
                        "description": "No content"
                    }
                }
            }
        },
        "/companies/{companyId}": {
            "get": {
                "operationId": "company.show",
                "summary": "The company profile and status",
                "tags": [
                    "Company"
                ],
                "parameters": [
                    {
                        "name": "companyId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`CompanyResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/CompanyResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFoundHttpException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            },
            "patch": {
                "operationId": "company.update",
                "summary": "Changes the profile. `lock_version` is required; the functional currency can only change while\nthe company is in `setup`",
                "tags": [
                    "Company"
                ],
                "parameters": [
                    {
                        "name": "companyId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateCompanyRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`CompanyResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/CompanyResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/companies/{companyId}/deactivate": {
            "post": {
                "operationId": "company.deactivate",
                "summary": "Makes the company inactive: its data becomes read-only",
                "tags": [
                    "Company"
                ],
                "parameters": [
                    {
                        "name": "companyId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`CompanyResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/CompanyResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/companies/{companyId}/reactivate": {
            "post": {
                "operationId": "company.reactivate",
                "summary": "Brings an inactive company back to `active`",
                "tags": [
                    "Company"
                ],
                "parameters": [
                    {
                        "name": "companyId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`CompanyResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/CompanyResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/companies/{companyId}/activate": {
            "post": {
                "operationId": "company.activate",
                "summary": "Activates the company (`setup` to `active`). Answers 422 `COMPANY_NOT_READY` with the missing\nprerequisites in `errors` when the chart of accounts, calendar or other setup is incomplete",
                "tags": [
                    "CompanyActivation"
                ],
                "parameters": [
                    {
                        "name": "companyId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`ActivatedCompanyResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/ActivatedCompanyResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/me": {
            "get": {
                "operationId": "me",
                "summary": "The signed-in user. Answers 401 `UNAUTHENTICATED` when there is no session, which is how the\nSPA learns that it must show the login screen",
                "tags": [
                    "Me"
                ],
                "responses": {
                    "200": {
                        "description": "`MeResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/MeResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/me/workspaces": {
            "get": {
                "operationId": "me.workspaces",
                "summary": "Workspaces the signed-in user can access right now: active, unexpired memberships only",
                "tags": [
                    "Me"
                ],
                "responses": {
                    "200": {
                        "description": "Array of `WorkspaceResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/WorkspaceResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/workspaces": {
            "post": {
                "operationId": "workspaces.store",
                "summary": "Creates a workspace together with its company (status `setup`); the caller becomes its first member",
                "tags": [
                    "Workspace"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateWorkspaceRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`CreatedWorkspaceResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/CreatedWorkspaceResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sessionCookie": {
                "type": "apiKey",
                "description": "First-party SPA: session cookie from the login flow, plus the XSRF-TOKEN cookie echoed in the X-XSRF-TOKEN header on writes.",
                "in": "cookie",
                "name": "accounting_session"
            },
            "bearerAuth": {
                "type": "http",
                "description": "Integration clients: OAuth 2.0 client-credentials access token. Treat it as opaque. Writes require an Idempotency-Key header.",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "ActivatedCompanyResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "legal_name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "tax_id": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "functional_currency": {
                        "type": "string"
                    },
                    "timezone": {
                        "type": "string"
                    },
                    "default_locale": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "lock_version": {
                        "type": "integer"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "legal_name",
                    "tax_id",
                    "functional_currency",
                    "timezone",
                    "default_locale",
                    "status",
                    "lock_version"
                ],
                "title": "ActivatedCompanyResource"
            },
            "CompanyResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "legal_name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "tax_id": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "functional_currency": {
                        "type": "string"
                    },
                    "timezone": {
                        "type": "string"
                    },
                    "default_locale": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "lock_version": {
                        "type": "integer"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "legal_name",
                    "tax_id",
                    "functional_currency",
                    "timezone",
                    "default_locale",
                    "status",
                    "lock_version"
                ],
                "title": "CompanyResource"
            },
            "CreateWorkspaceRequest": {
                "type": "object",
                "properties": {
                    "workspace_name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "company_name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "functional_currency": {
                        "type": "string",
                        "description": "Checked against the currency reference data once it exists (M2-03).",
                        "pattern": "^[A-Z]{3}$"
                    },
                    "timezone": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "default_locale": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "id",
                            "en",
                            null
                        ]
                    }
                },
                "required": [
                    "workspace_name",
                    "company_name",
                    "functional_currency"
                ],
                "title": "CreateWorkspaceRequest"
            },
            "CreatedWorkspaceResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "company_id": {
                        "type": "string"
                    },
                    "company_name": {
                        "type": "string"
                    },
                    "permissions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "id",
                    "name",
                    "company_id",
                    "company_name",
                    "permissions"
                ],
                "title": "CreatedWorkspaceResource"
            },
            "MeResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "email_verified": {
                        "type": "boolean"
                    },
                    "two_factor_enabled": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "email_verified",
                    "two_factor_enabled"
                ],
                "title": "MeResource"
            },
            "UpdateCompanyRequest": {
                "type": "object",
                "properties": {
                    "lock_version": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "legal_name": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 255
                    },
                    "tax_id": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 64
                    },
                    "functional_currency": {
                        "type": "string",
                        "description": "Only while the company is in setup (MD-AC-05); checked against currency reference data in M2-03.",
                        "pattern": "^[A-Z]{3}$"
                    },
                    "timezone": {
                        "type": "string"
                    },
                    "default_locale": {
                        "type": "string",
                        "enum": [
                            "id",
                            "en"
                        ]
                    }
                },
                "required": [
                    "lock_version"
                ],
                "title": "UpdateCompanyRequest"
            },
            "WorkspaceResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "company_id": {
                        "type": "string"
                    },
                    "company_name": {
                        "type": "string"
                    },
                    "permissions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "id",
                    "name",
                    "company_id",
                    "company_name",
                    "permissions"
                ],
                "title": "WorkspaceResource"
            }
        },
        "responses": {
            "NotFoundHttpException": {
                "description": "Not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            }
        }
    }
}